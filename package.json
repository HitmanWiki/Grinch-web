{
  "name": "pepe-grinch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=dist/server.mjs",
    "build:all": "npm run build && npm run build:server",
    "start": "node dist/server.mjs",
    "start:dev": "NODE_ENV=development tsx server.ts",
    "clean": "rm -rf dist",
    "clean:win": "rmdir /s /q dist",
    "lint": "tsc --noEmit",
    "copy:assets": "cp -r public dist/ || xcopy public dist /E /I /Y",
    "copy:assets:win": "xcopy public dist /E /I /Y",
    "postbuild": "npm run copy:assets || npm run copy:assets:win"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}